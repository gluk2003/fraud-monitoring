    {
      "title": "Результаты по версии модели · PostgreSQL",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT model_version, count(*) AS scores, avg(fraud_flag::int) AS fraud_ratio, avg(score) AS avg_score FROM scores WHERE $__timeFilter(scored_at) GROUP BY model_version ORDER BY model_version",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          }
        }
      ],
      "description": "Персистентные данные PostgreSQL в выбранном временном диапазоне, включая предыдущие запуски writer.",
